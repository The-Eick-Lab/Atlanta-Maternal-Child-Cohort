                        "0" = "No"),
       insurance_type = recode(insurance_type,
                        "0" = "Medicaid",
                        "1" = "Private"),
       type_home1 = recode(type_home1,
                           "1" = "Single family home",
                           "2" = "Multi family home",
                           "3" = "Apartment"),
       age_home1 = recode(age_home1,
                         "0" = "< 10 years old",
                         "1" = "≥ 10 years old"),
       pesticide_use = recode(pesticide_use,
                          "0" = "No",
                          "1" = "Yes"),
       cosmetic_use = recode(cosmetic_use,
                          "0" = "No",
                          "1" = "Yes"),
       sunscreen_use = recode(sunscreen_use,
