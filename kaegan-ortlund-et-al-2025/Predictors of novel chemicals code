predictors <- c("pesticide_use", "cosmetic_use", "sunscreen_use", "you_clean_home")

models <- list()
for (i in 1:length(outcomes)) {
  for (j in 1:length(predictors)) {
    model_name <- paste0(outcomes[i], " ~ ", predictors[j])
   formula <- as.formula(paste(outcomes[i], " ~ ", predictors[j]))
    model <- lm(formula = formula, data = novel)
    n_obs <- nobs(model)
    models[[model_name]] <- tidy(model, conf.int = TRUE) %>%
      mutate(N = n_obs, outcome = outcomes[i])
  }
}
home_reg_sums <- do.call(rbind, models) 

home_reg_sums <- home_reg_sums %>% 
  filter(term %in% c("pesticide_use1", "cosmetic_use1", "sunscreen_use1", "you_clean_home1")) %>%
  dplyr::select(outcome, term, N, estimate, conf.low, conf.high) 
