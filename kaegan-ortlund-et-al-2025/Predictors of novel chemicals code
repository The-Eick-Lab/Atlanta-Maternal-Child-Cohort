dplyr::select(maternal_age, maternal_education, marital_status, maternal_bmi_cat, insurance_type, parity, prenatal_site, substance_use, visit2_year, season, age_home1, type_home1, you_clean_home, pesticide_use, cosmetic_use, sunscreen_use, you_clean_home) %>%
